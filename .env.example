# Application
APP_NAME=Criminal Network Analysis System
APP_ENV=development
APP_DEBUG=true
BUILD_VERSION=0.8.0-phase8
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2: authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
DEMO_ACCOUNT_PASSWORD=SIH1@2026
SEED_DEMO_DATA=true
SEED_MOBILE_FRAUD_DEMO=false

# Phase 3: persistence and evidence storage
DATABASE_URL=postgresql+psycopg://sih:sih_dev_only@postgres:5432/sih
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sih_minio
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=evidence
MINIO_SECURE=false
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_ROOT=./data/objects
MAX_UPLOAD_BYTES=26214400

# Phase 4: asynchronous processing
REDIS_PASSWORD=replace-with-a-random-service-secret
CELERY_BROKER_URL=redis://:replace-with-a-random-service-secret@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-random-service-secret@redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_RESULT_EXPIRES_SECONDS=3600
FLOWER_BASIC_AUTH=analyst:replace-me

# Phase 5: local extraction and human review
SPACY_MODEL=en_core_web_sm
EXTRACTION_REVIEW_THRESHOLD=70
PADDLEOCR_ENABLED=true
PADDLEOCR_LANGUAGE=en,hi,mr,ka
PADDLEOCR_VERSION=PP-OCRv3
QWEN_BASE_URL=http://ollama:11434
QWEN_MODEL=qwen2.5:7b-instruct-q4_K_M
QWEN_ENABLED=true
QWEN_TIMEOUT_SECONDS=180
QWEN_NUM_CTX=4096
QWEN_ALLOWED_HOSTS=host.docker.internal,127.0.0.1,localhost,ollama

# Phase 6: entity resolution and graph analytics
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j
NEO4J_ALLOWED_HOSTS=neo4j,127.0.0.1,localhost
RESOLUTION_CANDIDATE_THRESHOLD=0.60
GRAPH_MAX_NODES_PER_CASE=5000
